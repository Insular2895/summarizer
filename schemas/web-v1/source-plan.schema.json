{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://summarizer.local/schemas/web-v1/source-plan.schema.json",
  "title": "Summarizer Web V1 source plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "videos"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "videos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["video_id", "youtube_id", "playlist_index", "title", "url"],
        "properties": {
          "video_id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "youtube_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "playlist_index": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "url": { "type": "string", "format": "uri", "maxLength": 2048 }
        }
      }
    }
  }
}
